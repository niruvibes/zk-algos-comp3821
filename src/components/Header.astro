---
// chat gave me this line, idk if im stupid but idk how to do it without this
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const { pageTitle = '' } = Astro.props;
---

<header class="l--flex -ai:center -jc:between -px:40 -py:20 -bd:b">
	<a href={`${base}/`} class="-fz:m -fw:bold -td:none -c:text">
		zk. <span class="-mis:5">How to prove nothing</span> <span id="nav-page-title" hidden aria-hidden="true" style="opacity: .5"> · {pageTitle} </span>
	</a>

	<nav class="l--cluster -g:30 -fz:s -c:text-2">
		<a href={`${base}/intro`} class="-td:none -c:inherit">Zero Knowledge Proofs</a>
		<a href={`${base}/commit`} class="-td:none -c:inherit">Commitment Schemes</a>
		<a href={`${base}/share`} class="-td:none -c:inherit">Secret Sharing</a>
		<a href={`${base}/mpc`} class="-td:none -c:inherit">Multi-Party Computation</a>
		<a href={`${base}/sign`} class="-td:none -c:inherit">Digital Signatures</a>
		<a href={`${base}/lessons`} class="-td:none -c:inherit">Lessons</a>
	</nav>
  
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 200;
    background: white;
  }
</style>

<script>
  const title = document.querySelector('.title-background');
  const label = document.querySelector<HTMLElement>('#nav-page-title')!;
  const header = document.querySelector('header')!;

  if (title) {
    const update = () => {
      label.hidden = title.getBoundingClientRect().bottom > header.getBoundingClientRect().bottom;
    };
    window.addEventListener('scroll', update, { passive: true });
    update();
  }
</script>