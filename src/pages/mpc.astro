---
import Layout from '../layouts/Layout.astro';
import MPC from '../components/mark/mpc.mdx'

const pageTitle = 'Multi-Party Computation';
---
<Layout title="Multi-Party Computation | ZK Proofs" pageTitle={pageTitle} stickyTitle>
    <Fragment slot="lesson-title">{pageTitle}</Fragment>

    <MPC />
    <!-- <label for="message">Ask a question</label>
        <input
        id="message"
        name="message"
        type="text"
        placeholder="Enter your question..."
    /> -->
</Layout>

<style>
    .list {
        font-size: 16px;
        line-height: 2;
        color: #444;
        padding-left: 24px;
        max-width: 550px;
    }

    .list li::before {
        content: "➜";
        color: #444;
        font-size: 14px;
    }

    .steps li::marker {
        color: #444;
        font-size: 14px;
    }
</style>
