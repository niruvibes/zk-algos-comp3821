---
import Layout from '../layouts/Layout.astro';
import MPCitH from '../components/mark/mpcith.mdx'

const pageTitle = 'MPC in the Head';
---
<Layout title="MPC in the Head | ZK Proofs" pageTitle={pageTitle}>
    <Fragment slot="lesson-title">MPC in the Head</Fragment>

    <MPCitH />
</Layout>

<style>
    .list {
        font-size: 16px;
        line-height: 2;
        color: #444;
        padding-left: 24px;
        max-width: 550px;
    }

    .list li::before {
        content: "➜";
        color: #444;
        font-size: 14px;
    }

    .steps li::marker {
        color: #444;
        font-size: 14px;
    }
</style>
