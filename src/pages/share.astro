---
import Layout from '../layouts/Layout.astro';
import Secret_Sharing from '../components/mark/secret_sharing.mdx';

// need to add this to all of the pages, and then also replace the page title in the layout woth the variable
const pageTitle = 'Secret Sharing Schemes';
---
<Layout title="Secret Sharing | ZK Proofs" pageTitle={pageTitle}>
    <Fragment slot="lesson-title">{pageTitle}</Fragment>

    <Secret_Sharing />
</Layout>

<style>
    .list {
        font-size: 16px;
        line-height: 2;
        color: #444;
        padding-left: 24px;
        max-width: 550px;
    }

    .list li::before {
        content: "➜";
        color: #444;
        font-size: 14px;
    }

    .steps li::marker {
        color: #444;
        font-size: 14px;
    }
</style>
