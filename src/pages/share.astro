---
import Layout from '../layouts/Layout.astro';
import TOC from '../components/TOC.astro';
import { WithSide, Box, Stack, Text, Heading } from 'lism-css/astro';
import Secret_Sharing from '../components/mark/secret_sharing.mdx';
---
<Layout title="Secret Sharing | ZK Proofs">
    <div class="title-background">
        <Heading level="1" fz="4xl" fw="700" lh="xs" class="content">
            Secret Sharing Schemes
        </Heading>
    </div>

    <Stack>        
        <div class="content-background">
            <Box class="content">
                <Secret_Sharing />
            </Box>
        </div>
    </Stack>
</Layout>

<style>
    .content-background {
        background-color: #f2f9ff;
        width: 100vw;
        margin-left: calc(50% - 50vw);
        padding: 32px 0;
    }

    .content {
        max-width: 800px;
        margin: 0 auto;
        padding: 0 32px;
    }

    .list {
        font-size: 16px;
        line-height: 2;
        color: #444;
        padding-left: 24px;
        max-width: 550px;
    }

    .list li::before {
        content: "➜";
        color: #444;
        font-size: 14px;
    }

    .steps li::marker {
        color: #444;
        font-size: 14px;
    }

    .title-background {
        position: sticky;
        top: 0;
        z-index: 100;
        isolation: isolate;
        background: transparent;
    }

    .title-background::before {
        content: "";
        position: absolute;
        z-index: -1;

        top: 0;
        bottom: 0;
        left: 50%;

        width: 100vw;
        transform: translateX(-50%);

        background-color: white;
    }

    .title-content {
        max-width: 1200px;
        margin: 0 auto;
        padding: 16px 32px;
    }   
</style>